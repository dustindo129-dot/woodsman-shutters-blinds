# Resend email configuration for the contact form.
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Where contact-form submissions are delivered.
CONTACT_TO=woodsmanshuttersandblindsllc@gmail.com

# The "from" address. Use a verified domain in production, e.g.
# "WoodsMan Website <website@woodsmanshuttersandblinds.com>".
# onboarding@resend.dev works for testing (delivers to the account owner only).
RESEND_FROM=WoodsMan Website <onboarding@resend.dev>

# Port for the local server.
PORT=5175
